<Window x:Class="Gda.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GDA-ZZZ · 绝区零" Width="940" Height="760" MinWidth="820" MinHeight="620" Background="#F5F6F8" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="GDA · 绝区零" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="安装一条龙，启动游戏，手机也能直接开始任务。" Foreground="#666" Margin="0,6,0,18"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="绝区零 Provider · OneDragon" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProviderStatus" Margin="0,6,0,8"/>
        <ProgressBar x:Name="InstallProgress" Height="5" Maximum="100" Margin="0,0,0,12"/>
        <WrapPanel>
          <Button x:Name="InstallButton" Content="安装绝区零 Provider" Click="Install_Click"/>
          <Button Content="启动绝区零" Click="Launch_Click"/>
          <Button Content="选择游戏文件" Click="Choose_Click"/>
        </WrapPanel>
        <TextBlock x:Name="GamePath" FontSize="12" Foreground="#777"/>
        <WrapPanel Margin="0,16,0,0">
          <CheckBox x:Name="Video" Content="影像店" IsChecked="True" Margin="0,0,16,12"/>
          <CheckBox x:Name="Scratch" Content="刮刮乐" IsChecked="True" Margin="0,0,16,12"/>
          <CheckBox x:Name="Coffee" Content="咖啡" IsChecked="True" Margin="0,0,16,12"/>
          <CheckBox x:Name="Rewards" Content="日常奖励" IsChecked="True" Margin="0,0,16,12"/>
        </WrapPanel>
        <WrapPanel><Button Content="开始任务" Click="Start_Click" Background="#2463EB" Foreground="White"/><Button Content="停止任务" Click="Stop_Click"/></WrapPanel>
        <TextBlock x:Name="TaskStatus"/>
        <TextBlock x:Name="ErrorText" Foreground="#BD2929" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,14,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox Grid.Row="1" x:Name="Logs" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="12"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="连接现有手机 App" FontWeight="SemiBold"/>
          <Image x:Name="Qr" Width="150" Height="150" Margin="0,8"/>
          <TextBlock x:Name="PhoneStatus" FontSize="12"/>
          <Button Content="复制连接码" Click="Copy_Click" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="退出 GDA" Click="Exit_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="0.1.0 · 真实执行 · 关闭窗口后仍可从手机操作" FontSize="12" Foreground="#777" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
